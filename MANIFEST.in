include README.md LICENSE
recursive-include docs *.md
recursive-include tests *.py
recursive-include bindings/javascript *.js *.ts *.json *.md LICENSE
recursive-include examples/languages *.go *.java *.cs *.csproj *.php *.rb *.mjs *.md
prune bindings/javascript/node_modules
prune examples/languages/csharp/bin
prune examples/languages/csharp/obj
