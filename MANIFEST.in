include README.md LICENSE
recursive-include runtime *.sh *.ps1 *.txt *.md uv-version
recursive-include tools *.mjs
recursive-include docs *.md
recursive-include tests *.py
recursive-include bindings/javascript *.js *.ts *.json *.md LICENSE
recursive-include bindings/c *.h *.md
recursive-include examples/languages *.go *.java *.cs *.csproj *.php *.rb *.mjs *.md *.c *.cpp *.rs CMakeLists.txt
prune bindings/javascript/node_modules
prune bindings/javascript/runtime
prune examples/languages/csharp/bin
prune examples/languages/csharp/obj
